# Copie para .env e preencha antes de rodar em produção.
# Em desenvolvimento, SECRET_KEY e DJANGO_DEBUG=true são suficientes.

DJANGO_DEBUG=false
SECRET_KEY=troque-por-uma-chave-segura-em-producao

POSTGRES_DB=nome_do_banco
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha_segura
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br

# Opcional — observabilidade
SENTRY_DSN=
APP_RELEASE=
