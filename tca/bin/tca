#!/usr/bin/env python3
"""
tca — CLI da Thronus Context Architecture.

Metodologia como artefato executável: os comandos aqui são a forma operante
dos portões que os skills descrevem em prosa.

Dependências: Python 3.8+ e a biblioteca padrão. Nada mais — a TCA é agnóstica
de stack e não pode impor runtime ao projeto que governa.

Comandos:
  tca version                    versão e hash do pacote
  tca verify-self                integridade do próprio pacote (MANIFEST.sha256)
  tca close-ms <MS-ID> [...]     fecha o ciclo de uma Micro Spec
  tca verify [--strict]          coerência dos artefatos de controle
  tca diff [--cached]            snapshot-diff bidirecional contra a spec
  tca selfcheck                  a verificação está de pé?
  tca canon [--write]            integridade do conteúdo metodológico
  tca doctor [--strict]          divergência entre o projeto e o canon
  tca agents [--write]           gera/verifica o AGENTS.md
  tca lock [--write]             fixa a origem e o hash do canon instalado
  tca tune [--write]             parâmetros derivados das métricas desta máquina
  tca update [--apply]           confere/aplica versão nova a partir da origem
  tca metrics [--repo D]         linha de base derivada do histórico
                                 (--medir-suite · --contar-testes · --medir-loop)

Todo comando emite registro de execução em
docs/ThronusSpec/05_Monitoramento/tca_execution_log.jsonl — portão que não
registra execução não é portão (ÂNCORA, invariante "portão executado").
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
from shlex import quote as shlex_quote

PKG_DIR = Path(__file__).resolve().parent.parent
MANIFEST = PKG_DIR / "MANIFEST.sha256"     # integridade do código do pacote
CANON = PKG_DIR / "CANON.sha256"           # integridade do conteúdo metodológico

# ── Caminhos que o contrato possui ───────────────────────────────────────────
P_INDEX = "docs/ThronusSpec/03_Desenvolvimento/payload_index.json"
P_ARCHIVE = "docs/ThronusSpec/03_Desenvolvimento/payload_archive"
P_LOGS = "docs/ThronusSpec/05_Monitoramento/performance_logs.json"
P_EXEC = "docs/ThronusSpec/05_Monitoramento/tca_execution_log.jsonl"
P_METRICAS = "docs/ThronusSpec/05_Monitoramento/metricas.jsonl"

# Contrato de comandos do projeto. Existe porque medir a suíte exige saber como
# ela roda, e adivinhar isso seria inferência. O projeto declara; a TCA executa.
#   {"comandos": {
#      "testes":             "pytest -q",
#      "contar_testes":      "pytest --collect-only -q | grep -c '::'",
#      "perfil_suite":       "<comando que imprime {setup,prepare,total} em JSON>",
#      "testes_relacionados":"pytest {arquivos}",
#      "contar_relacionados":"pytest --collect-only -q {arquivos} | grep -c '::'"}}
#
# Contratos de saída, porque parsear formato de runner seria inferência:
#   contar_testes / contar_relacionados → SOMENTE um inteiro em stdout
#   perfil_suite                        → um objeto JSON com setup, prepare e
#                                         total numéricos, em segundos
# Onde houver {arquivos}, a TCA substitui pela lista de caminhos alterados.
P_PROJETO_CFG = "tca.project.json"

# Sugestões de detecção. NUNCA executadas automaticamente: o operador confirma
# e declara. Ausência de declaração produz lacuna, não valor padrão.
DETECCAO = (
    ("pytest.ini", "pytest -q", "pytest --collect-only -q | grep -c '::'"),
    ("pyproject.toml", "pytest -q", "pytest --collect-only -q | grep -c '::'"),
    ("package.json", "npm test --silent", None),
    ("go.mod", "go test ./...", None),
    ("Cargo.toml", "cargo test", None),
)
P_CTX = "context/activeContext.md"

# Núcleo obrigatório do registro de archive. É o único contrato que a TCA
# possui sobre esse arquivo; tudo mais vive em `extensao`, livre para o projeto.
ARCHIVE_CORE = ("ms", "titulo", "data_conclusao", "fase", "tca", "contexto_ativo")

MS_RE = re.compile(r"^MS-\d{3,}$")

# Conteúdo metodológico: o que, alterado, muda o resultado que o método produz.
# Caminhos relativos à raiz do projeto — a mesma em template e derivados.
CANON_GLOBS = (
    "docs/ThronusSpec/02_Setup/*.md",
    "profiles/*.json",
    "tca/METODOLOGIA.md",
)

# AGENTS.md é gerado: metodologia canônica + parte do projeto. Um harness sem
# suporte a include precisa continuar lendo um arquivo só, então a concatenação
# é material — mas verificada, o que a distingue de uma cópia editada à mão.
P_METODOLOGIA = "tca/METODOLOGIA.md"
P_PROJETO = "PROJETO.md"
P_AGENTS = "AGENTS.md"

CABECALHO_AGENTS = """<!--
  GERADO por `tca agents --write` — não edite este arquivo.

  Metodologia : tca/METODOLOGIA.md   (canônica, verificada por tca canon)
  Projeto     : PROJETO.md           (editável, específico deste projeto)

  Editar aqui é perda garantida na próxima geração.
-->

"""

# Divergências deliberadas do projeto em relação ao canon.
P_OVERRIDES = "tca-overrides.json"

# Procedência da metodologia instalada. Fixa o hash do próprio CANON.sha256:
# sem isso, quem edita um skill e roda `tca canon --write` fica verde, porque o
# canon guarda a metodologia e nada guardaria o canon.
P_LOCK = "tca.lock.json"

# Ajuste por máquina. Derivado das métricas medidas NESTE ambiente, gerado e
# nunca editado. Não é versionado: é estado derivado e específico da máquina —
# versionar faria o ajuste de um ambiente governar os demais.
P_TUNING = ".tca/tuning-{host}.json"

# Artefatos que a própria TCA governa. O snapshot-diff compara mudança de
# PRODUTO contra a spec; estes são controlados pelo `verify` e apareceriam como
# inesperados em todo commit de fechamento, tornando o portão inútil.
ARTEFATOS_DE_CONTROLE = (
    P_CTX, P_INDEX, P_ARCHIVE, P_LOGS, P_EXEC, P_METRICAS,
    P_LOCK, P_PROJETO_CFG, P_OVERRIDES, ".tca/",
)


def _e_artefato_de_controle(caminho: str) -> bool:
    return any(caminho == a or caminho.startswith(a.rstrip("/") + "/")
               for a in ARTEFATOS_DE_CONTROLE)


class TcaError(Exception):
    """Erro de uso ou de estado. Mensagem vai para stderr, exit != 0."""


# ── utilidades ───────────────────────────────────────────────────────────────

def agora() -> str:
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def hoje() -> str:
    return datetime.now().strftime("%Y-%m-%d")


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for bloco in iter(lambda: fh.read(65536), b""):
            h.update(bloco)
    return h.hexdigest()


def versao_pacote() -> str:
    f = PKG_DIR / "VERSION"
    return f.read_text(encoding="utf-8").strip() if f.exists() else "desconhecida"


def hash_manifesto() -> str:
    return sha256(MANIFEST)[:12] if MANIFEST.exists() else "sem-manifesto"


def ambiente() -> dict:
    """Impressão digital da máquina.

    Medida de tempo sem ambiente é incomparável: 26s numa máquina de 4 núcleos
    com disco mecânico não é o mesmo número que 26s noutra. Sem isto, séries de
    máquinas diferentes se misturam em silêncio e a linha de base mente.
    """
    import platform
    ram_gb = None
    try:
        ram_gb = round(os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") / 1024**3)
    except (ValueError, OSError, AttributeError):
        pass
    rotacional = None
    try:
        # lsblk resolve LVM e mapper; caminhar /sys/block à mão não resolve.
        dev = os.popen("findmnt -no SOURCE --target . 2>/dev/null").read().strip()
        if dev:
            saida = os.popen(f"lsblk -no ROTA {shlex_quote(dev)} 2>/dev/null").read().split()
            if saida:
                rotacional = saida[0] == "1"
    except Exception:
        pass
    return {
        "host": platform.node(),
        "cores": os.cpu_count(),
        "ram_gb": ram_gb,
        "disco_rotacional": rotacional,
        "so": f"{platform.system()} {platform.release()}",
    }


def achar_raiz(inicio: Path) -> Path:
    """Sobe até encontrar o payload_index.json. Falha explícita se não achar."""
    atual = inicio.resolve()
    for cand in [atual, *atual.parents]:
        if (cand / P_INDEX).is_file():
            return cand
    raise TcaError(
        f"{P_INDEX} não encontrado a partir de {inicio}.\n"
        "Este comando roda dentro de um projeto TCA."
    )


def ler_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise TcaError(f"arquivo ausente: {path}")
    except json.JSONDecodeError as e:
        raise TcaError(f"JSON inválido em {path}: {e}")


def escrever_json(path: Path, dados) -> None:
    """Escrita atômica por arquivo: tmp + replace."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tca-tmp")
    tmp.write_text(json.dumps(dados, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def registrar_execucao(raiz: Path, comando: str, resultado: str, detalhes: dict) -> None:
    """Evidência de execução. Append-only, uma linha JSON por invocação."""
    registro = {
        "ts": agora(),
        "comando": comando,
        "resultado": resultado,
        "tca_versao": versao_pacote(),
        "tca_manifesto": hash_manifesto(),
        "detalhes": detalhes,
    }
    destino = raiz / P_EXEC
    destino.parent.mkdir(parents=True, exist_ok=True)
    with destino.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(registro, ensure_ascii=False) + "\n")


# ── activeContext ────────────────────────────────────────────────────────────

def arquivos_declarados(texto: str) -> list[str] | None:
    """Arquivos que a spec prevê criar ou modificar.

    Devolve None quando o campo não existe — ausente é diferente de vazio.
    Campo ausente vira lacuna; campo com travessão significa "nenhum".

    Aceita as duas formas que o artefato usa:
        **Arquivos a criar/modificar:** src/a.py, src/b.py
        **Arquivos a criar/modificar:**
        - src/a.py
        - src/b.py
    """
    m = re.search(r"^\*\*Arquivos a criar/modificar:\*\*(.*)$", texto, re.MULTILINE)
    if not m:
        return None
    resto = m.group(1).strip()
    if resto in ("—", "-", "–"):
        return []
    itens: list[str] = []
    if resto:
        itens += [p.strip() for p in re.split(r"[,\s]+", resto) if p.strip()]
    # lista em marcadores nas linhas seguintes. A quebra de linha logo após o
    # campo produz um item vazio que não pode encerrar a leitura antes de começar.
    for linha in texto[m.end():].splitlines():
        alvo = linha.strip()
        if not alvo:
            if itens:
                break          # linha vazia depois da lista encerra
            continue           # linha vazia antes da lista é só a quebra do campo
        if alvo.startswith("**"):
            break              # próximo campo
        if not alvo.startswith(("-", "*", "•")):
            break              # texto que não é item encerra
        itens.append(alvo.lstrip("-*• ").strip())
    return [i for i in itens if i and i not in ("—", "-", "–")]


def ms_ativa_no_contexto(texto: str) -> str | None:
    """Lê o campo `**MS ativa:**`. Travessão, vazio ou ausência = sem MS ativa."""
    m = re.search(r"^\*\*MS ativa:\*\*\s*(.*)$", texto, re.MULTILINE)
    if not m:
        return None
    valor = m.group(1).strip()
    return None if valor in ("", "—", "-", "–") else valor


CTX_VAZIO = """# Active Context — TCA Session RAM

> Este arquivo é a RAM da sessão TCA. É preenchido e limpo automaticamente pelo pipeline.
> Não editar manualmente durante uma sessão ativa.

**Fase atual:** {fase}
**MS ativa:** —
**Arquivos a criar/modificar:** —
**Cenários BDD:** —
"""


# ── comandos ─────────────────────────────────────────────────────────────────

def cmd_version(_args) -> int:
    print(f"tca {versao_pacote()} · manifesto {hash_manifesto()}")
    return 0


def cmd_verify_self(_args) -> int:
    """Integridade do próprio pacote. A TCA é fonte canônica: precisa ser verificável."""
    if not MANIFEST.exists():
        print(f"FALHA  MANIFEST.sha256 ausente em {PKG_DIR}", file=sys.stderr)
        return 1
    falhas = []
    verificados = 0
    for linha in MANIFEST.read_text(encoding="utf-8").splitlines():
        linha = linha.strip()
        if not linha or linha.startswith("#"):
            continue
        esperado, _, nome = linha.partition("  ")
        alvo = PKG_DIR / nome
        if not alvo.is_file():
            falhas.append(f"ausente: {nome}")
            continue
        obtido = sha256(alvo)
        verificados += 1
        if obtido != esperado:
            falhas.append(f"hash divergente: {nome}")
    for f in falhas:
        print(f"FALHA  {f}", file=sys.stderr)
    print(f"{'FALHA' if falhas else 'OK':<6} integridade do pacote — {verificados} arquivos verificados")
    return 1 if falhas else 0


def cmd_close_ms(args) -> int:
    raiz = achar_raiz(Path.cwd())
    ms = args.ms_id.strip().upper()
    if not MS_RE.match(ms):
        raise TcaError(f"MS-ID inválido: {ms!r}. Formato: MS-NNN (ex.: MS-021).")

    idx_path = raiz / P_INDEX
    ctx_path = raiz / P_CTX
    arq_path = raiz / P_ARCHIVE / f"{ms.lower().replace('-', '')}.json"

    indice = ler_json(idx_path)
    estado = indice.setdefault("estado_da_trilha", {})

    # Idempotência: fechar o que já está fechado é no-op, não erro.
    if arq_path.exists() and estado.get("ultima_micro_spec_concluida") == ms:
        print(f"OK     {ms} já fechada — nada a fazer.")
        registrar_execucao(raiz, "close-ms", "no-op", {"ms": ms})
        return 0

    if not ctx_path.exists():
        raise TcaError(f"{P_CTX} não existe. Não há ciclo aberto para fechar.")
    contexto = ctx_path.read_text(encoding="utf-8")
    ativa = ms_ativa_no_contexto(contexto)

    # Título: lido do contexto ou informado. Nunca inventado.
    titulo = args.titulo
    if not titulo and ativa:
        titulo = re.sub(r"^MS-\d+\s*[—:-]\s*", "", ativa).strip() or ativa
    if not titulo:
        raise TcaError(
            "não foi possível determinar o título da MS.\n"
            "O activeContext não declara `**MS ativa:**` e --titulo não foi informado.\n"
            "Lacuna declarada, não preenchida por inferência."
        )

    if args.dry_run:
        print(f"[dry-run] fecharia {ms} — {titulo}")
        print(f"[dry-run]   criaria  {arq_path.relative_to(raiz)}")
        print(f"[dry-run]   limparia {P_CTX}")
        return 0

    # 1. registro de archive — núcleo obrigatório + contexto verbatim
    registro = {
        "ms": ms,
        "titulo": titulo,
        "data_conclusao": hoje(),
        "fase": estado.get("fase_atual"),
        "tca": {"versao": versao_pacote(), "manifesto": hash_manifesto()},
        "contexto_ativo": contexto,
        "extensao": {},
    }
    if args.testes is not None:
        registro["testes"] = args.testes
    escrever_json(arq_path, registro)

    # 2. índice — só os campos que o contrato possui; o resto é preservado
    estado["ultima_micro_spec_concluida"] = ms
    estado["micro_spec_ativa"] = None
    if args.testes is not None:
        estado["total_testes"] = args.testes
    archive = indice.setdefault("_archive", {})
    chaves = sorted({p.stem for p in (raiz / P_ARCHIVE).glob("*.json")})
    archive["keys"] = chaves
    escrever_json(idx_path, indice)

    # 3. log de performance
    logs_path = raiz / P_LOGS
    logs = ler_json(logs_path) if logs_path.exists() else {"projeto": indice.get("projeto"), "registros": []}
    registros = logs.setdefault("registros", [])
    if not any(r.get("ms") == ms for r in registros):
        registros.append({
            "ms": ms,
            "titulo": titulo,
            "data_conclusao": hoje(),
            "testes": args.testes,
        })
    escrever_json(logs_path, logs)

    # 4. limpeza da RAM da sessão
    ctx_path.write_text(CTX_VAZIO.format(fase=estado.get("fase_atual") or "—"), encoding="utf-8")

    registrar_execucao(raiz, "close-ms", "ok", {
        "ms": ms, "titulo": titulo,
        "archive": str(arq_path.relative_to(raiz)),
        "archives_total": len(chaves),
    })

    print(f"OK     {ms} fechada — {titulo}")
    print(f"       archive  {arq_path.relative_to(raiz)}")
    print(f"       índice   ultima_micro_spec_concluida={ms} · _archive.keys={len(chaves)}")
    print(f"       contexto {P_CTX} limpo")
    if args.testes is None:
        print("AVISO  total_testes não informado (--testes N). Campo mantido como estava.")
    return 0


def cmd_verify(args) -> int:
    raiz = achar_raiz(Path.cwd())
    falhas: list[str] = []
    avisos: list[str] = []

    indice = ler_json(raiz / P_INDEX)
    estado = indice.get("estado_da_trilha", {})
    arch_dir = raiz / P_ARCHIVE
    arquivos = sorted(arch_dir.glob("*.json")) if arch_dir.is_dir() else []

    # 1. JSON válido nos artefatos de controle
    logs_path = raiz / P_LOGS
    if logs_path.exists():
        ler_json(logs_path)

    # 2. _archive.keys reflete o diretório
    keys_decl = set(indice.get("_archive", {}).get("keys", []))
    keys_reais = {p.stem for p in arquivos}
    if keys_decl != keys_reais:
        falhas.append(
            f"_archive.keys diverge do diretório — "
            f"só no índice: {sorted(keys_decl - keys_reais) or '—'}; "
            f"só no disco: {sorted(keys_reais - keys_decl) or '—'}"
        )

    # 3. MS ativa no contexto ⟺ micro_spec_ativa no índice
    ctx_path = raiz / P_CTX
    ativa_ctx = ms_ativa_no_contexto(ctx_path.read_text(encoding="utf-8")) if ctx_path.exists() else None
    ativa_idx = estado.get("micro_spec_ativa")
    if bool(ativa_ctx) != bool(ativa_idx):
        falhas.append(
            f"MS ativa incoerente — activeContext={ativa_ctx!r}, índice={ativa_idx!r}. "
            "Ciclo aberto sem registro, ou fechado sem limpeza."
        )

    # 4. última MS concluída tem archive
    ultima = estado.get("ultima_micro_spec_concluida")
    if ultima:
        esperado = ultima.lower().replace("-", "")
        if esperado not in keys_reais:
            falhas.append(f"ultima_micro_spec_concluida={ultima} sem archive correspondente ({esperado}.json)")

    # 5. núcleo do archive — aviso por padrão, falha em --strict
    for p in arquivos:
        try:
            d = json.loads(p.read_text(encoding="utf-8"))
        except json.JSONDecodeError as e:
            falhas.append(f"{p.name}: JSON inválido ({e})")
            continue
        faltando = [k for k in ARCHIVE_CORE if k not in d]
        if faltando:
            (falhas if args.strict else avisos).append(
                f"{p.name}: núcleo incompleto — faltam {', '.join(faltando)}"
            )

    # 6. AGENTS.md é conteúdo gerado — precisa estar em dia com suas fontes
    if (raiz / P_METODOLOGIA).is_file() and (raiz / P_PROJETO).is_file():
        alvo = raiz / P_AGENTS
        try:
            if not alvo.exists():
                falhas.append(f"{P_AGENTS} ausente — rode: tca agents --write")
            elif alvo.read_text(encoding="utf-8") != _agents_esperado(raiz):
                falhas.append(
                    f"{P_AGENTS} desatualizado ou editado à mão — rode: tca agents --write"
                )
        except TcaError as e:
            falhas.append(str(e))

    # 7. campos não deriváveis — lacuna declarada, não falha
    if "status_modulo_percentual" in estado:
        avisos.append(
            "status_modulo_percentual não é derivável: o schema não define campo de backlog. "
            "Lacuna declarada — ver tca/README.md."
        )

    for a in avisos:
        print(f"AVISO  {a}")
    for f in falhas:
        print(f"FALHA  {f}", file=sys.stderr)

    resultado = "falha" if falhas else "ok"
    registrar_execucao(raiz, "verify", resultado, {
        "archives": len(arquivos), "falhas": len(falhas), "avisos": len(avisos),
        "strict": bool(args.strict),
    })
    print(f"{'FALHA' if falhas else 'OK':<6} coerência de estado — "
          f"{len(arquivos)} archives · {len(falhas)} falhas · {len(avisos)} avisos")
    return 1 if falhas else 0


def _canon_arquivos(raiz: Path) -> list[Path]:
    achados: list[Path] = []
    for padrao in CANON_GLOBS:
        achados.extend(sorted(raiz.glob(padrao)))
    return achados


def _ler_canon() -> dict[str, str]:
    if not CANON.exists():
        raise TcaError(f"CANON.sha256 ausente em {PKG_DIR}. Rode: tca canon --write")
    mapa = {}
    for linha in CANON.read_text(encoding="utf-8").splitlines():
        linha = linha.strip()
        if not linha or linha.startswith("#"):
            continue
        h, _, nome = linha.partition("  ")
        mapa[nome] = h
    return mapa


def cmd_canon(args) -> int:
    """Gera ou verifica o hash do conteúdo metodológico deste repositório."""
    raiz = PKG_DIR.parent
    arquivos = _canon_arquivos(raiz)
    if not arquivos:
        raise TcaError(f"nenhum conteúdo metodológico encontrado sob {raiz}")

    if args.write:
        linhas = [f"{sha256(f)}  {f.relative_to(raiz).as_posix()}" for f in arquivos]
        CANON.write_text("\n".join(linhas) + "\n", encoding="utf-8")
        print(f"OK     CANON.sha256 escrito — {len(linhas)} arquivos")
        return 0

    esperado = _ler_canon()
    reais = {f.relative_to(raiz).as_posix(): sha256(f) for f in arquivos}
    falhas = []
    for nome, h in esperado.items():
        if nome not in reais:
            falhas.append(f"ausente no repositório: {nome}")
        elif reais[nome] != h:
            falhas.append(f"hash divergente: {nome}")
    for nome in reais.keys() - esperado.keys():
        falhas.append(f"não declarado no canon: {nome}")
    for f in falhas:
        print(f"FALHA  {f}", file=sys.stderr)
    print(f"{'FALHA' if falhas else 'OK':<6} conteúdo metodológico — {len(esperado)} arquivos declarados")
    return 1 if falhas else 0


def _agents_esperado(raiz: Path) -> str:
    met = raiz / P_METODOLOGIA
    prj = raiz / P_PROJETO
    for f in (met, prj):
        if not f.is_file():
            raise TcaError(f"fonte ausente: {f.relative_to(raiz)}")
    return (CABECALHO_AGENTS
            + met.read_text(encoding="utf-8").rstrip()
            + "\n\n---\n\n"
            + prj.read_text(encoding="utf-8").lstrip())


def cmd_agents(args) -> int:
    """Gera o AGENTS.md a partir da metodologia canônica e da parte do projeto."""
    # Funciona no template (que não tem payload_index) e no projeto derivado.
    try:
        raiz = achar_raiz(Path.cwd())
    except TcaError:
        raiz = PKG_DIR.parent
    esperado = _agents_esperado(raiz)
    alvo = raiz / P_AGENTS

    if args.write:
        alvo.write_text(esperado, encoding="utf-8")
        print(f"OK     {P_AGENTS} gerado — {len(esperado.splitlines())} linhas")
        return 0

    atual = alvo.read_text(encoding="utf-8") if alvo.exists() else None
    if atual is None:
        print(f"FALHA  {P_AGENTS} não existe. Rode: tca agents --write", file=sys.stderr)
        return 1
    if atual != esperado:
        print(f"FALHA  {P_AGENTS} está desatualizado ou foi editado à mão.", file=sys.stderr)
        print(f"       Edite {P_METODOLOGIA} ou {P_PROJETO} e rode: tca agents --write", file=sys.stderr)
        return 1
    print(f"OK     {P_AGENTS} em dia com {P_METODOLOGIA} + {P_PROJETO}")
    return 0


def _git(raiz: Path, *args: str) -> str | None:
    import subprocess
    try:
        r = subprocess.run(["git", "-C", str(raiz), *args],
                           capture_output=True, text=True, timeout=120)
        # None significa falha. Sucesso sem saída devolve "" — `git clone --quiet`
        # não imprime nada, e confundir os dois quebrava o --apply.
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None


def cmd_lock(args) -> int:
    """Registra de onde veio a metodologia instalada e qual canon foi instalado."""
    try:
        raiz = achar_raiz(Path.cwd())
    except TcaError:
        raiz = PKG_DIR.parent
    lock_path = raiz / P_LOCK

    if not CANON.exists():
        raise TcaError("CANON.sha256 ausente — não há o que fixar. Rode: tca canon --write")

    if args.write:
        origem = args.origem or _git(raiz, "remote", "get-url", "origin") or "desconhecida"
        ref = args.ref or _git(raiz, "rev-parse", "HEAD") or "desconhecida"
        dados = {
            "tca": {
                "origem": origem,
                "versao": versao_pacote(),
                "ref": ref,
                "canon_sha256": sha256(CANON),
                "instalado_em": hoje(),
            }
        }
        escrever_json(lock_path, dados)
        print(f"OK     {P_LOCK} escrito — tca {dados['tca']['versao']} · canon {dados['tca']['canon_sha256'][:12]}")
        return 0

    if not lock_path.exists():
        print(f"FALHA  {P_LOCK} ausente. Rode: tca lock --write", file=sys.stderr)
        return 1
    d = ler_json(lock_path).get("tca", {})
    atual = sha256(CANON)
    print(f"       origem   {d.get('origem')}")
    print(f"       versão   {d.get('versao')} · ref {str(d.get('ref'))[:12]}")
    if d.get("canon_sha256") != atual:
        print(f"FALHA  canon divergente do instalado — "
              f"fixado {str(d.get('canon_sha256'))[:12]}, atual {atual[:12]}", file=sys.stderr)
        return 1
    print(f"OK     canon confere com o instalado ({atual[:12]})")
    return 0


def _semver(tag: str) -> tuple[int, int, int] | None:
    m = re.match(r"^v?(\d+)\.(\d+)\.(\d+)$", tag)
    return tuple(int(x) for x in m.groups()) if m else None


def _tags_remotas(origem: str) -> list[tuple[tuple[int, int, int], str]]:
    saida = _git(Path.cwd(), "ls-remote", "--tags", origem)
    if saida is None:
        raise TcaError(f"não foi possível listar tags de {origem}")
    achadas = []
    for linha in saida.splitlines():
        _, _, ref = linha.partition("refs/tags/")
        ref = ref.strip().removesuffix("^{}")
        v = _semver(ref)
        if v and (v, ref) not in achadas:
            achadas.append((v, ref))
    return sorted(achadas)


def cmd_update(args) -> int:
    """Confere defasagem em relação à origem declarada no lock, e opcionalmente aplica."""
    import shutil as _sh
    import tempfile as _tmp

    try:
        raiz = achar_raiz(Path.cwd())
    except TcaError:
        raiz = PKG_DIR.parent
    lock_path = raiz / P_LOCK
    if not lock_path.exists():
        raise TcaError(f"{P_LOCK} ausente — sem procedência declarada não há o que atualizar.")
    lock = ler_json(lock_path).get("tca", {})
    origem = lock.get("origem")
    if not origem or origem == "desconhecida":
        raise TcaError(f"{P_LOCK} não declara origem utilizável.")

    tags = _tags_remotas(origem)
    if not tags:
        print(f"AVISO  nenhuma tag de versão em {origem}")
        return 0
    ultima_v, ultima_tag = tags[-1]
    instalada = _semver(str(lock.get("versao", ""))) or (0, 0, 0)

    print(f"       instalada  {lock.get('versao')} · ref {str(lock.get('ref'))[:12]}")
    print(f"       disponível {ultima_tag}")

    if instalada >= ultima_v:
        print("OK     metodologia em dia")
        registrar_execucao(raiz, "update", "ok", {"instalada": lock.get("versao"), "disponivel": ultima_tag})
        return 0

    print(f"ATRASO metodologia {lock.get('versao')} atrás de {ultima_tag}")
    if not args.apply:
        print("       Use --apply para atualizar, ou fixe a versão deliberadamente.")
        registrar_execucao(raiz, "update", "atraso", {"instalada": lock.get("versao"), "disponivel": ultima_tag})
        return 1

    # Aplicar sobrescreve conteúdo metodológico: divergência não declarada seria
    # perdida em silêncio. Recusa antes de destruir.
    declarados = set()
    ov = raiz / P_OVERRIDES
    if ov.exists():
        declarados = {o["arquivo"] for o in ler_json(ov).get("overrides", [])}
    sujos = [n for n, h in _ler_canon().items()
             if n not in declarados and (raiz / n).is_file() and sha256(raiz / n) != h]
    if sujos:
        print("FALHA  divergência não declarada impediria a atualização — "
              "seria perdida em silêncio:", file=sys.stderr)
        for n in sujos:
            print(f"       {n}", file=sys.stderr)
        print("       Declare em tca-overrides.json ou reverta antes de atualizar.", file=sys.stderr)
        return 1

    tmpdir = Path(_tmp.mkdtemp())
    try:
        if _git(Path.cwd(), "clone", "--quiet", "--depth", "1", "--branch", ultima_tag,
                origem, str(tmpdir / "origem")) is None:
            raise TcaError(f"falha ao obter {ultima_tag} de {origem}")
        novo = tmpdir / "origem"
        preservados, atualizados = [], []
        for rel in [*_canon_arquivos(novo), *(novo / "tca").rglob("*")]:
            if not rel.is_file():
                continue
            nome = rel.relative_to(novo).as_posix()
            if nome in declarados:
                preservados.append(nome)
                continue
            destino = raiz / nome
            destino.parent.mkdir(parents=True, exist_ok=True)
            _sh.copy2(rel, destino)
            atualizados.append(nome)
        for n in preservados:
            print(f"PRESERVA {n}  (override declarado)")
        print(f"OK     {len(atualizados)} arquivos atualizados para {ultima_tag}")
    finally:
        _sh.rmtree(tmpdir, ignore_errors=True)

    escrever_json(lock_path, {"tca": {
        "origem": origem, "versao": ultima_tag.lstrip("v"), "ref": ultima_tag,
        "canon_sha256": sha256(CANON), "instalado_em": hoje(),
    }})
    print(f"       {P_LOCK} atualizado. Rode: tca agents --write && tca doctor --strict")
    registrar_execucao(raiz, "update", "aplicado", {"para": ultima_tag, "arquivos": len(atualizados)})
    return 0


def _mediana(xs: list[float]) -> float | None:
    if not xs:
        return None
    ys = sorted(xs)
    n = len(ys)
    return ys[n // 2] if n % 2 else (ys[n // 2 - 1] + ys[n // 2]) / 2


def _commits_por_ms(raiz: Path, desde: str | None) -> dict[str, list[dict]]:
    """Agrupa commits por MS-NNN citado no assunto. Só o que o git já registra."""
    faixa = [f"{desde}..HEAD"] if desde else []
    saida = _git(raiz, "log", *faixa, "--no-merges", "--numstat",
                 "--date=iso-strict", "--format=%x01%H%x02%ad%x02%s")
    if saida is None:
        raise TcaError(f"não foi possível ler o histórico git de {raiz}")

    por_ms: dict[str, list[dict]] = {}
    for bloco in saida.split("\x01"):
        bloco = bloco.strip("\n")
        if not bloco:
            continue
        cab, _, corpo = bloco.partition("\n")
        partes = cab.split("\x02")
        if len(partes) < 3:
            continue
        sha, data, assunto = partes[0], partes[1], partes[2]
        m = re.search(r"\bMS-(\d{3,})\b", assunto)
        if not m:
            continue
        arquivos, add, rem = [], 0, 0
        for linha in corpo.splitlines():
            campos = linha.split("\t")
            if len(campos) != 3:
                continue
            a, r, nome = campos
            arquivos.append(nome)
            add += int(a) if a.isdigit() else 0
            rem += int(r) if r.isdigit() else 0
        ms = f"MS-{m.group(1)}"
        por_ms.setdefault(ms, []).append({
            "sha": sha, "data": data, "assunto": assunto,
            "arquivos": arquivos, "add": add, "rem": rem,
            "correcao": bool(re.match(r"^(fix|hotfix)\b", assunto)),
        })
    return por_ms


def _ler_cfg(raiz: Path) -> dict:
    f = raiz / P_PROJETO_CFG
    return ler_json(f).get("comandos", {}) if f.exists() else {}


def _rodar(raiz: Path, comando: str, timeout: int) -> tuple[int, str, float]:
    """Executa um comando declarado pelo projeto e cronometra. Nunca infere comando."""
    import subprocess
    import time as _t
    t0 = _t.monotonic()
    try:
        r = subprocess.run(comando, cwd=str(raiz), shell=True, capture_output=True,
                           text=True, timeout=timeout)
        return r.returncode, r.stdout, _t.monotonic() - t0
    except subprocess.TimeoutExpired:
        return 124, "", _t.monotonic() - t0


def _lacuna_cfg(raiz: Path, chave: str) -> dict:
    sugestoes = [(m, t, c) for m, t, c in DETECCAO if (raiz / m).exists()]
    dica = f" Detectado {sugestoes[0][0]}; sugestão: {sugestoes[0][1]!r}." if sugestoes else ""
    return {"_lacuna": f"{P_PROJETO_CFG} não declara comandos.{chave}.{dica}"}


def _contar_testes(raiz: Path, timeout: int) -> dict:
    """Conta os testes. Não roda a suíte — contar é barato e não precisa de ambiente."""
    contar = _ler_cfg(raiz).get("contar_testes")
    if not contar:
        return _lacuna_cfg(raiz, "contar_testes")
    cod, saida, _ = _rodar(raiz, contar, timeout)
    texto = saida.strip().splitlines()[-1].strip() if saida.strip() else ""
    if cod == 0 and texto.isdigit():
        return {"suite_testes": {"valor": int(texto), "origem": "derivado:execucao",
                                 "comando": contar}}
    return {"suite_testes": {"valor": None, "origem": "lacuna",
                             "nota": "contar_testes não imprimiu somente um inteiro"}}


def _medir_suite(raiz: Path, timeout: int) -> dict:
    """Executa e cronometra a suíte. Exige o ambiente completo do projeto."""
    alvo = _ler_cfg(raiz).get("testes")
    if not alvo:
        return _lacuna_cfg(raiz, "testes")
    cod, _saida, seg = _rodar(raiz, alvo, timeout)
    return {"suite_segundos": {"valor": round(seg, 1), "origem": "derivado:execucao",
                               "comando": alvo,
                               "resultado": "ok" if cod == 0 else f"exit {cod}"}}


def _perfil_suite(raiz: Path, timeout: int) -> dict:
    """Fração do tempo gasta preparando ambiente em vez de testando.

    É o indicador estrutural: quando sobe, a suíte está pagando por arquivo em
    vez de por teste — e é isso que torna o laço local lento sem que ninguém
    tenha escrito um teste ruim.
    """
    cmd = _ler_cfg(raiz).get("perfil_suite")
    if not cmd:
        return _lacuna_cfg(raiz, "perfil_suite")
    cod, saida, _ = _rodar(raiz, cmd, timeout)
    try:
        d = json.loads(saida.strip().splitlines()[-1])
        setup, prepare, total = float(d["setup"]), float(d["prepare"]), float(d["total"])
    except Exception:
        return {"overhead_pct": {"valor": None, "origem": "lacuna",
                                 "nota": "perfil_suite não imprimiu {setup,prepare,total} em JSON"}}
    if cod != 0 or total <= 0:
        return {"overhead_pct": {"valor": None, "origem": "lacuna",
                                 "nota": f"perfil_suite falhou (exit {cod})"}}
    return {"overhead_pct": {"valor": round(100 * (setup + prepare) / total, 1),
                             "origem": "derivado:execucao", "comando": cmd,
                             "nota": f"setup {setup:.1f}s + prepare {prepare:.1f}s de {total:.1f}s"}}


def _medir_loop(raiz: Path, timeout: int, amostra: int, total_testes: int | None) -> dict:
    """Custo do laço local sobre mudanças reais, não sobre uma mudança inventada.

    A amostra são os últimos commits: o que já foi alterado é a melhor
    aproximação do que será alterado.
    """
    import shlex
    cmds = _ler_cfg(raiz)
    rodar_rel = cmds.get("testes_relacionados")
    if not rodar_rel:
        return _lacuna_cfg(raiz, "testes_relacionados")

    # Commit que não seleciona teste algum — só configuração ou documento — não
    # mede laço de desenvolvimento. Olha-se mais para trás até completar a
    # amostra, com teto de varredura para não percorrer o histórico inteiro.
    contar_rel = cmds.get("contar_relacionados")
    limite = max(amostra * 6, 20)
    shas = (_git(raiz, "log", "-n", str(limite), "--no-merges", "--format=%H") or "").split()
    tempos, selecionados, varridos, pulados = [], [], 0, 0
    for sha in shas:
        if len(tempos) >= amostra:
            break
        varridos += 1
        saida = _git(raiz, "show", "--name-only", "--format=", sha) or ""
        arquivos = [f for f in saida.split() if (raiz / f).is_file()][:40]
        if not arquivos:
            pulados += 1
            continue
        lista = " ".join(shlex.quote(f) for f in arquivos)
        n_sel = None
        if contar_rel:
            c_cod, c_saida, _ = _rodar(raiz, contar_rel.replace("{arquivos}", lista), timeout)
            txt = c_saida.strip().splitlines()[-1].strip() if c_saida.strip() else ""
            n_sel = int(txt) if c_cod == 0 and txt.isdigit() else None
            if n_sel == 0:
                pulados += 1
                continue
        _cod, _s, seg = _rodar(raiz, rodar_rel.replace("{arquivos}", lista), timeout)
        tempos.append(seg)
        if n_sel:
            selecionados.append(n_sel)

    if not tempos:
        return {"loop_local_segundos": {"valor": None, "origem": "lacuna",
                                        "nota": "nenhum commit da amostra alterou arquivo existente"}}
    saida = {"loop_local_segundos": {
        "valor": round(_mediana(tempos), 1), "origem": "derivado:execucao",
        "comando": rodar_rel,
        "nota": f"mediana de {len(tempos)} commits com teste relacionado "
                f"({varridos} varridos, {pulados} sem seleção)"}}
    if selecionados and total_testes:
        saida["testes_selecionados_pct"] = {
            "valor": round(100 * _mediana(selecionados) / total_testes, 1),
            "origem": "derivado:execucao",
            "nota": f"mediana {_mediana(selecionados):.0f} de {total_testes} testes"}
    elif selecionados:
        saida["testes_selecionados_pct"] = {
            "valor": None, "origem": "lacuna",
            "nota": "exige suite_testes — use também --contar-testes"}
    return saida


def cmd_diff(args) -> int:
    """Snapshot-diff bidirecional: o previsto e não entregue também reprova.

    O gate descrito nos skills procura arquivo inesperado. Arquivo previsto que
    não apareceu passava sem ruído — e é essa a assinatura da entrega parcial.
    """
    raiz = achar_raiz(Path.cwd())
    ctx_path = raiz / P_CTX
    if not ctx_path.exists():
        raise TcaError(f"{P_CTX} não existe — não há spec contra a qual comparar.")
    texto = ctx_path.read_text(encoding="utf-8")
    declarados = arquivos_declarados(texto)
    if declarados is None:
        raise TcaError(
            f"{P_CTX} não declara `**Arquivos a criar/modificar:**`.\n"
            "Sem lista prevista não há snapshot-diff — lacuna, não aprovação."
        )

    faixa = ["--cached"] if args.cached else ["HEAD"]
    saida = _git(raiz, "diff", "--name-only", *faixa)
    if saida is None:
        raise TcaError("não foi possível ler o diff do git")
    tocados = {l.strip() for l in saida.splitlines()
               if l.strip() and not _e_artefato_de_controle(l.strip())}
    previstos = set(declarados)

    inesperados = sorted(tocados - previstos)
    faltantes = sorted(previstos - tocados)
    ok = sorted(tocados & previstos)

    for f in inesperados:
        print(f"INESPERADO {f}")
    for f in faltantes:
        print(f"FALTANTE   {f}  (previsto na spec, não entregue)")

    falhou = bool(inesperados or faltantes)
    registrar_execucao(raiz, "diff", "falha" if falhou else "ok", {
        "previstos": len(previstos), "tocados": len(tocados),
        "inesperados": len(inesperados), "faltantes": len(faltantes),
        "cached": bool(args.cached),
    })
    print(f"{'FALHA' if falhou else 'OK':<6} snapshot-diff — {len(ok)} conforme · "
          f"{len(inesperados)} inesperados · {len(faltantes)} faltantes "
          f"(artefatos de controle não contam)")
    return 1 if falhou else 0


def cmd_selfcheck(args) -> int:
    """A verificação está de pé?

    Responde ao incidente em que um estágio de teste rodava sem banco: toda
    execução falhava, o estágio dependente nunca era alcançado, e o
    desconhecimento durou dias porque ninguém perguntava se a própria
    verificação executava.
    """
    raiz = achar_raiz(Path.cwd())
    amb = ambiente()
    falhas, avisos = [], []

    # 1. O contrato de execução existe?
    cmds = _ler_cfg(raiz)
    if not cmds.get("testes"):
        falhas.append(f"{P_PROJETO_CFG} não declara comandos.testes — "
                      "não há como afirmar que a suíte roda")
    if not cmds.get("contar_testes"):
        avisos.append(f"{P_PROJETO_CFG} não declara comandos.contar_testes — "
                      "queda silenciosa na contagem fica indetectável")

    # 2. A contagem caiu? É o sinal de suíte que parou de executar.
    atual = None
    if cmds.get("contar_testes"):
        med = _contar_testes(raiz, args.timeout)
        atual = med.get("suite_testes", {}).get("valor")
        if atual is None:
            falhas.append("contar_testes não devolveu um inteiro — contagem indisponível")

    anterior = None
    reg = _ultimo_registro_do_ambiente(raiz, amb["host"])
    if reg:
        anterior = reg.get("indicadores", {}).get("suite_testes", {}).get("valor")

    if atual is not None and anterior is not None:
        queda = anterior - atual
        margem = max(1, int(anterior * args.tolerancia / 100))
        if queda > margem:
            falhas.append(f"contagem de testes caiu de {anterior} para {atual} "
                          f"(queda de {queda}, tolerância {margem})")
        else:
            print(f"       contagem {atual} contra {anterior} da última medição — dentro da tolerância")
    elif atual is not None:
        avisos.append(f"sem medição anterior nesta máquina para comparar "
                      f"({atual} testes agora) — rode: tca metrics --contar-testes --write")

    # 3. A última medição de suíte registrada passou?
    if reg:
        res = reg.get("indicadores", {}).get("suite_segundos", {}).get("resultado")
        if res and res != "ok":
            falhas.append(f"última execução registrada da suíte terminou em {res}")

    for a in avisos:
        print(f"AVISO  {a}")
    for f in falhas:
        print(f"FALHA  {f}", file=sys.stderr)

    registrar_execucao(raiz, "selfcheck", "falha" if falhas else "ok", {
        "testes_agora": atual, "testes_antes": anterior,
        "falhas": len(falhas), "avisos": len(avisos),
    })
    print(f"{'FALHA' if falhas else 'OK':<6} verificação de pé — "
          f"{len(falhas)} falhas · {len(avisos)} avisos")
    return 1 if falhas else 0


def cmd_metrics(args) -> int:
    """Linha de base do processo, derivada do que já aconteceu.

    Não muda nada no fluxo e não pede dado novo: lê git e os archives. Cada
    indicador declara sua origem, e o que não é instrumentável hoje é listado
    como lacuna em vez de estimado.
    """
    from datetime import datetime as _dt

    raiz = Path(args.repo).resolve() if args.repo else achar_raiz(Path.cwd())
    if not (raiz / ".git").exists():
        raise TcaError(f"{raiz} não é um repositório git — sem histórico não há linha de base.")

    por_ms = _commits_por_ms(raiz, args.desde)
    sem_historico = not por_ms
    if sem_historico:
        print("AVISO  nenhum commit cita MS-NNN no assunto — indicadores de MS não deriváveis.")
        print("       A convenção Conventional Commits com MS-ID é o que os torna mensuráveis.")

    def _quando(c):
        return _dt.fromisoformat(c["data"])

    commits_por, arquivos_por, linhas_por, duracao_por = [], [], [], []
    correcoes_pos_fechamento = 0
    fechamentos: list[tuple] = []

    for ms, cs in por_ms.items():
        # git log vem do mais novo para o mais antigo. Inverter preserva a ordem
        # real mesmo quando dois commits caem no mesmo segundo — comparar por
        # timestamp perde a ordem em commits rápidos.
        cs.reverse()
        commits_por.append(len(cs))
        arquivos_por.append(len({a for c in cs for a in c["arquivos"]}))
        linhas_por.append(sum(c["add"] + c["rem"] for c in cs))
        if len(cs) > 1:
            duracao_por.append((_quando(cs[-1]) - _quando(cs[0])).total_seconds() / 3600)
        fechamentos.append((_quando(cs[-1]), ms))
        # Correção depois do primeiro commit não-correção da MS: proxy de retrabalho.
        # Por posição, não por data, pelo mesmo motivo.
        i_feat = next((i for i, c in enumerate(cs) if not c["correcao"]), None)
        if i_feat is not None:
            correcoes_pos_fechamento += sum(1 for c in cs[i_feat + 1:] if c["correcao"])

    fechamentos.sort()
    lead_times = [(fechamentos[i + 1][0] - fechamentos[i][0]).total_seconds() / 3600
                  for i in range(len(fechamentos) - 1)]
    n_ms = len(por_ms)

    # testes por MS: só o campo canônico. Histórico legado não é remapeado por
    # inferência — a cobertura do campo é reportada como está.
    arch_dir = raiz / P_ARCHIVE
    archives = sorted(arch_dir.glob("*.json")) if arch_dir.is_dir() else []
    testes, com_campo = [], 0
    for a in archives:
        try:
            d = json.loads(a.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            continue
        if isinstance(d.get("testes"), int):
            testes.append(d["testes"])
            com_campo += 1

    # MS commitada sem registro de archive é o gap documental, quantificado.
    ms_com_archive = sum(
        1 for ms in por_ms if (arch_dir / f"{ms.lower().replace('-', '')}.json").exists())

    def ind(valor, origem, **extra):
        return {"valor": valor, "origem": origem, **extra}

    datas = sorted(c["data"] for cs in por_ms.values() for c in cs)
    indicadores = {}
    if not sem_historico:
        indicadores = {
            "ms_entregues": ind(n_ms, "derivado:git"),
            "ms_com_archive_pct": ind(
                round(100 * ms_com_archive / n_ms, 1), "derivado:git+archives",
                nota=f"{ms_com_archive}/{n_ms} — gap documental"),
            "commits_por_ms_mediana": ind(_mediana(commits_por), "derivado:git"),
            "arquivos_por_ms_mediana": ind(_mediana(arquivos_por), "derivado:git"),
            "linhas_por_ms_mediana": ind(_mediana(linhas_por), "derivado:git"),
            "duracao_ms_horas_mediana": ind(_mediana(duracao_por), "derivado:git",
                                            nota=f"n={len(duracao_por)} MS com >1 commit"),
            "lead_time_entre_ms_horas_mediana": ind(_mediana(lead_times), "derivado:git"),
            "correcoes_apos_entrega": ind(correcoes_pos_fechamento, "derivado:git",
                                          nota="proxy de retrabalho"),
            "testes_por_ms_mediana": ind(_mediana(testes), "derivado:archives",
                                         cobertura=f"{com_campo}/{len(archives)}"),
        }
    registro = {
        "ts": agora(),
        "repo": raiz.name,
        "ref": _git(raiz, "rev-parse", "HEAD") or "desconhecida",
        "tca_versao": versao_pacote(),
        "ambiente": ambiente(),
        "janela": {"desde": datas[0][:10] if datas else None,
                   "ate": datas[-1][:10] if datas else None},
        "indicadores": indicadores,
        "nao_instrumentado": [
            "token_por_ms — o harness não expõe consumo ao processo",
            "ms_estacionadas e tempo_de_fila — exige a triagem em classes, que ainda não existe",
        ],
    }
    if args.suite_segundos is not None:
        registro["indicadores"]["suite_segundos"] = ind(args.suite_segundos, "reportado")

    if args.suite_segundos is None and not args.medir_suite:
        # Distinguir "falta declarar" de "falta ambiente": mandar declarar o que
        # já está declarado é diagnóstico errado.
        motivo = ("use --medir-suite, com o ambiente do projeto de pé"
                  if _ler_cfg(raiz).get("testes")
                  else f"declare comandos.testes em {P_PROJETO_CFG}")
        registro["nao_instrumentado"].insert(1, f"suite_segundos — {motivo}")

    def _aplicar(medida):
        if "_lacuna" in medida:
            registro["nao_instrumentado"].append(medida["_lacuna"])
        else:
            registro["indicadores"].update(medida)

    if args.medir_suite:
        _aplicar(_medir_suite(raiz, args.timeout))
    if args.medir_suite or args.contar_testes or args.medir_loop:
        _aplicar(_contar_testes(raiz, args.timeout))
    if args.perfil_suite:
        _aplicar(_perfil_suite(raiz, args.timeout))
    if args.medir_loop:
        total_t = registro["indicadores"].get("suite_testes", {}).get("valor")
        _aplicar(_medir_loop(raiz, args.timeout, args.amostra, total_t))

    amb = registro["ambiente"]
    disco = {True: "mecânico", False: "SSD", None: "?"}[amb["disco_rotacional"]]
    print(f"       ambiente {amb['host']} · {amb['cores']} núcleos · "
          f"{amb['ram_gb']}GB · disco {disco}")
    jan = registro["janela"]
    janela_txt = f"janela {jan['desde']} → {jan['ate']}" if jan["desde"] else "sem janela de MS"
    print(f"       repositório {raiz.name} · {janela_txt}")
    for nome, d in registro["indicadores"].items():
        v = d["valor"]
        v = "—" if v is None else (f"{v:.1f}" if isinstance(v, float) else str(v))
        extra = f"  [{d.get('cobertura') or d.get('nota') or d['origem']}]"
        print(f"       {nome:38} {v:>9}{extra}")
    if args.detectar:
        print("       detecção — sugestões para declarar, nunca executadas sozinhas:")
        achou = False
        for marcador, testes, contar in DETECCAO:
            if (raiz / marcador).exists():
                achou = True
                print(f"         · {marcador}: comandos.testes = {testes!r}")
                if contar:
                    print(f"           {' ' * len(marcador)}  comandos.contar_testes = {contar!r}")
        if not achou:
            print("         · nenhum marcador conhecido — declare manualmente")

    print("       não instrumentado:")
    for n in registro["nao_instrumentado"]:
        print(f"         · {n}")

    if args.write:
        destino = raiz / P_METRICAS
        destino.parent.mkdir(parents=True, exist_ok=True)
        with destino.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(registro, ensure_ascii=False) + "\n")
        registrar_execucao(raiz, "metrics", "ok", {"ms": n_ms})
        print(f"OK     linha de base gravada em {P_METRICAS}")
    else:
        print("OK     modo relatório — nada foi escrito. Use --write para fixar a linha de base.")
    return 0


def _ultimo_registro_do_ambiente(raiz: Path, host: str) -> dict | None:
    """Última medição feita NESTA máquina. Misturar ambientes corrompe a série."""
    f = raiz / P_METRICAS
    if not f.exists():
        return None
    achado = None
    for linha in f.read_text(encoding="utf-8").splitlines():
        linha = linha.strip()
        if not linha:
            continue
        try:
            r = json.loads(linha)
        except json.JSONDecodeError:
            continue
        if r.get("ambiente", {}).get("host") == host:
            achado = r
    return achado


def cmd_tune(args) -> int:
    """Deriva parâmetros de execução a partir do que foi medido nesta máquina.

    A TCA **emite**; o projeto **consome**. Nenhuma configuração de runner é
    alterada aqui: escrever no vitest.config.ts do projeto seria a TCA
    introduzindo conteúdo que o projeto não declarou.
    """
    try:
        raiz = achar_raiz(Path.cwd())
    except TcaError:
        raiz = PKG_DIR.parent
    amb = ambiente()
    reg = _ultimo_registro_do_ambiente(raiz, amb["host"])
    ind = (reg or {}).get("indicadores", {})

    def valor(nome):
        v = ind.get(nome, {})
        return v.get("valor") if isinstance(v, dict) else None

    cores = amb["cores"] or 2
    rotacional = amb["disco_rotacional"]
    overhead = valor("overhead_pct")
    loop = valor("loop_local_segundos")
    suite = valor("suite_segundos")
    sel_pct = valor("testes_selecionados_pct")

    rec: list[dict] = []

    # Concorrência: o teto é o número de núcleos. Em disco mecânico, o gargalo é
    # I/O e saturar os núcleos só aumenta disputa pelo disco.
    conc = max(1, cores - 1) if rotacional else cores
    rec.append({
        "parametro": "concorrencia_max", "valor": conc,
        "porque": "disco mecânico: reservar um núcleo reduz disputa de I/O" if rotacional
                  else "um trabalhador por núcleo",
        "evidencia": f"{cores} núcleos · disco "
                     f"{'mecânico' if rotacional else 'SSD' if rotacional is False else 'indeterminado'}",
    })

    if overhead is None:
        rec.append({"parametro": "isolamento_por_arquivo", "valor": None,
                    "porque": "sem medição de overhead nesta máquina",
                    "evidencia": "rode: tca metrics --perfil-suite --write"})
    elif overhead >= 60:
        rec.append({
            "parametro": "isolamento_por_arquivo", "valor": False,
            "porque": "preparar ambiente por arquivo domina o tempo; desligar o "
                      "isolamento na camada sem I/O devolve a maior parte dele",
            "evidencia": f"overhead_pct={overhead} — {ind['overhead_pct'].get('nota', '')}",
        })
    else:
        rec.append({"parametro": "isolamento_por_arquivo", "valor": True,
                    "porque": "overhead baixo; isolamento não é o gargalo aqui",
                    "evidencia": f"overhead_pct={overhead}"})

    if loop is not None and suite:
        rec.append({
            "parametro": "laco_local_por_selecao", "valor": True,
            "porque": "selecionar por impacto custa uma fração da suíte completa",
            "evidencia": f"laço {loop}s contra suíte {suite}s"
                         + (f" · {sel_pct}% dos testes selecionados" if sel_pct else ""),
        })
    elif loop is not None:
        rec.append({"parametro": "laco_local_por_selecao", "valor": True,
                    "porque": "laço por seleção medido; falta o total para comparar",
                    "evidencia": f"laço {loop}s · rode --medir-suite para o total"})

    if rotacional:
        rec.append({
            "parametro": "observadores_redundantes", "valor": False,
            "porque": "cada observador varre a árvore; em disco mecânico isso "
                      "compete com a própria execução dos testes",
            "evidencia": "disco rotacional detectado",
        })

    dados = {
        "_gerado_por": "tca tune — não edite; regenere",
        "ambiente": amb,
        "baseado_em": {"ts": (reg or {}).get("ts"), "ref": (reg or {}).get("ref"),
                       "tca_versao": (reg or {}).get("tca_versao")} if reg else None,
        "parametros": {r["parametro"]: r["valor"] for r in rec},
        "recomendacoes": rec,
    }

    disco = {True: "mecânico", False: "SSD", None: "?"}[rotacional]
    print(f"       ambiente {amb['host']} · {cores} núcleos · {amb['ram_gb']}GB · disco {disco}")
    if not reg:
        print(f"AVISO  nenhuma medição desta máquina em {P_METRICAS} — "
              "parâmetros derivam só do hardware.")
    else:
        print(f"       medição base {reg['ts'][:19]} · tca {reg.get('tca_versao')}")
    for r in rec:
        v = "—" if r["valor"] is None else str(r["valor"])
        print(f"       {r['parametro']:28} {v:>7}   {r['porque']}")
        print(f"       {'':28} {'':>7}   [{r['evidencia']}]")

    if args.write:
        destino = raiz / P_TUNING.format(host=amb["host"])
        escrever_json(destino, dados)
        registrar_execucao(raiz, "tune", "ok", {"host": amb["host"]})
        print(f"OK     {destino.relative_to(raiz)} gerado — o projeto consome se quiser")
    else:
        print("OK     modo relatório — use --write para gerar o arquivo por máquina.")
    return 0


def cmd_doctor(args) -> int:
    """Divergência entre a metodologia deste projeto e o canon declarado.

    É o detector de inferência local: desvio declarado em tca-overrides.json é
    decisão registrada; desvio não declarado é divergência silenciosa.
    """
    raiz = achar_raiz(Path.cwd())
    esperado = _ler_canon()

    declarados = {}
    ov_path = raiz / P_OVERRIDES
    if ov_path.exists():
        for o in ler_json(ov_path).get("overrides", []):
            if not all(k in o for k in ("arquivo", "motivo", "responsavel")):
                raise TcaError(
                    f"{P_OVERRIDES}: todo override exige arquivo, motivo e responsavel. "
                    "Papel genérico não satisfaz."
                )
            declarados[o["arquivo"]] = o

    # O canon regenerado localmente esconderia toda divergência de arquivo.
    canon_regenerado = False
    lock_path = raiz / P_LOCK
    if lock_path.exists():
        fixado = ler_json(lock_path).get("tca", {}).get("canon_sha256")
        if fixado and fixado != sha256(CANON):
            canon_regenerado = True

    idem, divergentes, ausentes, extras, com_override = [], [], [], [], []
    for nome, h in esperado.items():
        alvo = raiz / nome
        if not alvo.is_file():
            (com_override if nome in declarados else ausentes).append(nome)
        elif sha256(alvo) == h:
            idem.append(nome)
        else:
            (com_override if nome in declarados else divergentes).append(nome)

    for padrao in CANON_GLOBS:
        for f in sorted(raiz.glob(padrao)):
            nome = f.relative_to(raiz).as_posix()
            if nome not in esperado:
                extras.append(nome)

    for n in divergentes:
        print(f"DIVERGE  {n}")
    for n in ausentes:
        print(f"AUSENTE  {n}")
    for n in extras:
        print(f"EXTRA    {n}  (não declarado no canon)")
    for n in com_override:
        o = declarados[n]
        print(f"OVERRIDE {n}  — {o['motivo']} ({o['responsavel']})")

    if canon_regenerado:
        print("CANON    tca/CANON.sha256 foi regenerado neste projeto — "
              "o hash não confere com o fixado em tca.lock.json")
        print("         Metodologia alterada localmente. Declare override ou "
              "atualize a versão da TCA.")

    nao_declarados = len(divergentes) + len(ausentes) + len(extras) + int(canon_regenerado)
    registrar_execucao(raiz, "doctor", "falha" if (nao_declarados and args.strict) else "ok", {
        "identicos": len(idem), "divergentes": len(divergentes),
        "ausentes": len(ausentes), "extras": len(extras),
        "overrides": len(com_override), "canon_regenerado": canon_regenerado,
        "strict": bool(args.strict),
    })

    estado = "FALHA" if (nao_declarados and args.strict) else "OK"
    print(f"{estado:<6} metodologia — {len(idem)} idênticos · {nao_declarados} divergências "
          f"não declaradas · {len(com_override)} overrides")
    if nao_declarados and not args.strict:
        print("       modo relatório. Use --strict para reprovar, ou declare em "
              f"{P_OVERRIDES}.")
    return 1 if (nao_declarados and args.strict) else 0


# ── entrada ──────────────────────────────────────────────────────────────────

def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="tca", description="Thronus Context Architecture — CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("version", help="versão e hash do pacote").set_defaults(fn=cmd_version)
    sub.add_parser("verify-self", help="integridade do próprio pacote").set_defaults(fn=cmd_verify_self)

    c = sub.add_parser("close-ms", help="fecha o ciclo de uma Micro Spec")
    c.add_argument("ms_id", help="identificador, formato MS-NNN")
    c.add_argument("--titulo", help="título da MS; se omitido, lido do activeContext")
    c.add_argument("--testes", type=int, help="total de testes da suíte após a MS")
    c.add_argument("--dry-run", action="store_true", help="mostra o que faria, sem escrever")
    c.set_defaults(fn=cmd_close_ms)

    v = sub.add_parser("verify", help="coerência dos artefatos de controle")
    v.add_argument("--strict", action="store_true", help="núcleo de archive incompleto reprova")
    v.set_defaults(fn=cmd_verify)

    df = sub.add_parser("diff", help="snapshot-diff bidirecional contra a spec")
    df.add_argument("--cached", action="store_true",
                    help="compara só o que está em staging (uso no portão de commit)")
    df.set_defaults(fn=cmd_diff)

    sc = sub.add_parser("selfcheck", help="a verificação está de pé?")
    sc.add_argument("--tolerancia", type=float, default=2.0,
                    help="queda percentual tolerada na contagem de testes (padrão 2%%)")
    sc.add_argument("--timeout", type=int, default=600, help="limite em segundos")
    sc.set_defaults(fn=cmd_selfcheck)

    k = sub.add_parser("canon", help="integridade do conteúdo metodológico")
    k.add_argument("--write", action="store_true", help="regenera CANON.sha256 a partir do repositório")
    k.set_defaults(fn=cmd_canon)

    g = sub.add_parser("agents", help="gera/verifica o AGENTS.md")
    g.add_argument("--write", action="store_true", help="regenera o AGENTS.md a partir das fontes")
    g.set_defaults(fn=cmd_agents)

    l = sub.add_parser("lock", help="fixa a origem e o hash do canon instalado")
    l.add_argument("--write", action="store_true", help="escreve o tca.lock.json")
    l.add_argument("--origem", help="URL de origem da metodologia")
    l.add_argument("--ref", help="commit ou tag da versão instalada")
    l.set_defaults(fn=cmd_lock)

    u = sub.add_parser("update", help="confere/aplica versão nova a partir da origem")
    u.add_argument("--apply", action="store_true", help="baixa e aplica a última versão")
    u.set_defaults(fn=cmd_update)

    m = sub.add_parser("metrics", help="linha de base derivada do histórico")
    m.add_argument("--repo", help="repositório a medir (padrão: o projeto atual)")
    m.add_argument("--desde", help="ref git inicial da janela (padrão: todo o histórico)")
    m.add_argument("--suite-segundos", type=int, dest="suite_segundos",
                   help="tempo da suíte completa, em segundos — valor reportado")
    m.add_argument("--medir-suite", action="store_true", dest="medir_suite",
                   help=f"executa e cronometra a suíte declarada em {P_PROJETO_CFG}")
    m.add_argument("--contar-testes", action="store_true", dest="contar_testes",
                   help="conta os testes sem executar a suíte — não exige ambiente")
    m.add_argument("--perfil-suite", action="store_true", dest="perfil_suite",
                   help="fração do tempo gasta preparando ambiente (overhead_pct)")
    m.add_argument("--medir-loop", action="store_true", dest="medir_loop",
                   help="custo do laço local sobre os últimos commits reais")
    m.add_argument("--amostra", type=int, default=5,
                   help="quantos commits recentes amostrar em --medir-loop (padrão 5)")
    m.add_argument("--timeout", type=int, default=1800,
                   help="limite em segundos para a suíte (padrão 1800)")
    m.add_argument("--detectar", action="store_true",
                   help="sugere comandos a declarar, sem executar nenhum")
    m.add_argument("--write", action="store_true", help="grava a linha de base")
    m.set_defaults(fn=cmd_metrics)

    t = sub.add_parser("tune", help="parâmetros derivados das métricas desta máquina")
    t.add_argument("--write", action="store_true", help="gera .tca/tuning-<host>.json")
    t.set_defaults(fn=cmd_tune)

    d = sub.add_parser("doctor", help="divergência entre o projeto e o canon")
    d.add_argument("--strict", action="store_true", help="divergência não declarada reprova")
    d.set_defaults(fn=cmd_doctor)

    args = p.parse_args(argv)
    try:
        return args.fn(args)
    except TcaError as e:
        print(f"ERRO   {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
